# Copy to .env and adjust. Nested settings use the double underscore separator.

# --- Engine ---
APP__ENGINE=faster-whisper          # faster-whisper | openai-whisper | cloud-transcribe
MODEL__SIZE=large-v3-turbo          # tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
DEVICE=cpu                          # cpu | cuda
COMPUTE_TYPE=int8                   # int8 (cpu) | float16 (cuda)

# --- Speaker diarization ---
# Create a token at https://huggingface.co/settings/tokens and accept the model terms.
HUGGINGFACE_TOKEN=
DIARIZER_MODEL=pyannote/speaker-diarization-3.1

# --- Post-processing (optional, never blocks the job) ---
POST__PROVIDER=none                 # none | ollama | openai
OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__MODEL=llama3.1
CLOUD__API_KEY=
CLOUD__MODEL=gpt-4o-transcribe

# --- Server / storage ---
MEDIA__DIR=./media
MAX_UPLOAD_MB=512
JOB__WORKERS=2
SSE__ENABLED=true
